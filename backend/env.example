# Strapi Configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# Database Configuration
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://username:password@host:port/database
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# App Keys (generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))")
APP_KEYS=your_app_key_1,your_app_key_2,your_app_key_3,your_app_key_4

# API Token Salt (generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))")
API_TOKEN_SALT=your_api_token_salt

# Admin JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))")
ADMIN_JWT_SECRET=your_admin_jwt_secret

# Transfer Token Salt (generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))")
TRANSFER_TOKEN_SALT=your_transfer_token_salt

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))")
JWT_SECRET=your_jwt_secret

# Public URL (will be set by Railway)
PUBLIC_URL=https://your-app-name.railway.app
